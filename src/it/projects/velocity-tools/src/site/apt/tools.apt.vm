Velocity tools

 configured=$configured.hello()

 setter=$setter.depth

 date=$date.format( $date.toDate( 'yyyy-MM-dd', '2026-10-26' ) )

 render=$render.eval( '#if( true )$esc.html( "<b>" )#end' )

 esc=$esc.xml( "a'b" )

 sorter=#foreach( $key in $sorter.sort( ['b', 'c', 'a'] ) )$key#end


 convert=$convert.toBoolean( 'true' )

 text=$text.get( 'template.version' )

 context=$context.contains( 'configured' )
